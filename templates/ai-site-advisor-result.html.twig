{% set titles = {'records': 'Structured node records'|t, 'page': 'A standalone page'|t, 'mixed': 'Records + a landing page'|t, 'unclear': 'More detail needed'|t, 'not_applicable': 'No change requested here'|t, 'drupal_display': 'Drupal entity displays'|t, 'canvas_template': 'Shared Canvas template'|t, 'canvas_page': 'Standalone Canvas page'|t, 'canvas_both': 'Canvas template + landing page'|t} %}
{% set labels = {'ready': 'Reuse candidate'|t, 'extend': 'Needs extension'|t, 'unrelated': 'Different purpose'|t, 'unknown': 'Needs clarification'|t, 'relevant': 'Relevant capability'|t} %}
{% set availability = {'local_code': 'Code available locally'|t, 'catalog_only': 'Available in the ecosystem'|t, 'enabled_module': 'Module already enabled'|t} %}
{% set roles = {'foundation': 'Possible foundation'|t, 'complement': 'Possible addition'|t, 'unrelated': 'Different purpose'|t, 'unknown': 'Insufficient evidence'|t} %}
<section class="sa-result" aria-live="polite">
  <div class="sa-section-title"><div><span class="sa-eyebrow">{{ 'Draft · review before building'|t }}</span><h3>{{ assessment.plan.title }}</h3></div><span class="sa-badge">{{ assessment.model }}</span></div>
  <p>{{ assessment.plan.before_building }}</p>
  <p class="sa-note">{{ (assessment.elapsed_ms / 1000)|number_format(2) }} s {{ 'total'|t }} · {{ 'Read-only advice'|t }} · {{ 'Provider usage is available with the evidence below.'|t }}</p>
  <div class="sa-next">
    <strong>{{ assessment.search_plan.action == 'search' ? 'Search the ecosystem'|t : (assessment.search_plan.action == 'clarify' ? 'Clarify before searching'|t : 'Start with this site'|t) }}</strong>
    <p>{{ assessment.search_plan.reason }}</p>
    {% if assessment.search_plan.query %}<p>{{ 'Searched for'|t }}: <strong>{{ assessment.search_plan.queries ? assessment.search_plan.queries|join(' · ') : assessment.search_plan.query }}</strong></p>{% endif %}
  </div>
  <h4>01 · {{ 'Plan each capability'|t }}</h4>
  {% if assessment.search_plan.coverage %}<p class="sa-note">{{ 'Reviewed @processed of @total text segments and identified @areas work areas. Check these against your brief; processing every segment does not guarantee that every requirement was understood.'|t({'@processed': assessment.search_plan.coverage.segments_processed, '@total': assessment.search_plan.coverage.segments_total, '@areas': assessment.search_plan.coverage.capabilities}) }}</p>{% endif %}
  {% if assessment.search_plan.terms_truncated %}<p class="sa-review">{{ 'The configured extraction service returned an incomplete scope. Review the missing requirements before using this draft.'|t }}</p>{% endif %}
  {% if assessment.search_plan.unmapped_clauses %}<details class="sa-details"><summary>{{ 'Parts without a separate work area'|t }}</summary><p>{{ 'Check that these are context or details covered elsewhere in the plan.'|t }}</p><ul>{% for clause in assessment.search_plan.unmapped_clauses %}<li>{{ clause }}</li>{% endfor %}</ul></details>{% endif %}
  <ol class="sa-plan">
    {% for area in assessment.plan.areas %}
      <li class="sa-card sa-plan-area {{ area.needs_review ? 'sa-review' : 'sa-recommendation' }}">
        <div class="sa-section-title"><h4>{{ area.label|capitalize }}</h4><span class="sa-badge">{{ area.needs_review ? 'Open decision'|t : (area.package ? 'Candidate to investigate'|t : 'Configure and verify'|t) }}</span></div>
        <p class="sa-note">{{ 'From your brief'|t }}: “{{ area.source_text }}”</p>
        <p><strong>{{ area.action }}</strong>{% if area.package %} · <code>{{ area.package }}</code>{% endif %}</p>
        <p>{{ area.evidence|length > 380 ? area.evidence|slice(0, 380) ~ '…' : area.evidence }}</p>
        <p class="sa-selection"><strong>{{ 'Preferred starting point'|t }}:</strong> {{ area.selection.label }}{% if area.selection.probability is not null %} · {{ (area.selection.probability * 100)|number_format(0) }}%{% endif %}{% if area.selection.confidence is not null %} · {{ 'confidence'|t }} {{ (area.selection.confidence * 100)|number_format(0) }}%{% endif %}{% if area.selection.needs_review %} · {{ 'Review needed'|t }}{% endif %}</p>
        <p class="sa-plan-check"><strong>{{ 'Resolve before building'|t }}:</strong> {{ area.check }}{% if area.check_needs_review %} <em>{{ 'Confirm this check with the site builder.'|t }}</em>{% endif %}</p>
        <div class="sa-assembly">
            <strong>{{ 'Building blocks to investigate'|t }}</strong>
            {% if area.assembly.foundations %}<p>{{ 'Foundations to compare'|t }}: {{ area.assembly.foundations|join(' · ') }}</p>{% endif %}
            {% if area.assembly.complements %}<p>{{ 'Possible additions'|t }}: {{ area.assembly.complements|join(' · ') }}</p>{% endif %}
            {% if area.assembly.roles_needing_review %}<p class="sa-note">{{ 'Uncertain roles to review'|t }}: {{ area.assembly.roles_needing_review|join(' · ') }}</p>{% endif %}
            <p>{{ area.assembly.guidance }}</p>
        </div>
        <details class="sa-options"><summary>{{ 'Options, scores and remaining gap'|t }} · {{ area.options|length }}</summary>
          <p>{{ area.gap }}</p>
          <p class="sa-note">{{ 'Starting-point probability compares competing options. Contribution assesses each option independently for this work area. Whole-brief relevance can include other work areas. None of these probabilities establishes complete coverage or a working integration.'|t }}</p>
          <p class="sa-note">{{ 'All assessed options are shown, including low-probability and unrelated results. Our review policy flags choices below 75% probability or 70% confidence, unclear answers and conflicting judgments. These thresholds are not calibrated quality guarantees.'|t }}</p>
          <div class="sa-table-scroll" role="region" aria-label="{{ 'Assessed options for @area'|t({'@area': area.label}) }}" tabindex="0">
            <table class="sa-options-table">
              <caption>{{ 'Assessed options for @area'|t({'@area': area.label}) }}</caption>
              <thead><tr><th scope="col">{{ 'Option and evidence'|t }}</th><th scope="col">{{ 'Contribution here'|t }}</th><th scope="col">{{ 'Starting point'|t }}</th><th scope="col">{{ 'Whole-brief relevance'|t }}</th></tr></thead>
              <tbody>
                {% for option in area.options %}
                  <tr>
                    <th scope="row">
                      <strong>{{ option.label }}</strong>{% if option.selected %}<span class="sa-option-selected">{{ 'Preferred in this comparison'|t }}</span>{% endif %}
                      {% if option.package %}<code>{{ option.package }}</code>{% elseif option.bundle_id %}<span class="sa-note">{{ 'Existing content type'|t }}</span>{% endif %}
                      <details><summary>{{ 'Source evidence'|t }}</summary><p>{{ option.description }}</p>{% if option.fields %}<p>{{ 'Current fields'|t }}: {{ option.fields|join(' · ') }}</p>{% endif %}{% if option.source %}<p class="sa-note">{{ option.source }}</p>{% endif %}</details>
                      {% if option.url %}<a href="{{ option.url }}" target="_blank" rel="noopener noreferrer">{{ 'Inspect project'|t }} →</a>{% endif %}
                      {% if option.bundle_id %}<a href="{{ path('entity.node_type.edit_form', {'node_type': option.bundle_id}) }}">{{ 'Inspect content type'|t }} →</a>{% endif %}
                    </th>
                    <td>
                      {% if option.contribution %}
                        <strong>{{ roles[option.contribution.choice] }}</strong><br>{{ (option.contribution.probabilities[option.contribution.choice] * 100)|number_format(0) }}% · {{ 'confidence'|t }} {{ (option.contribution.confidence * 100)|number_format(0) }}%
                        {% if option.contribution.needs_review %}<p class="sa-note">{{ 'Review this role'|t }}</p>{% endif %}
                        <details><summary>{{ 'Role scores'|t }}</summary><p>{{ option.contribution.criterion }}</p><dl>{% for role, probability in option.contribution.probabilities %}<dt>{{ roles[role] }}</dt><dd>{{ (probability * 100)|number_format(0) }}%</dd>{% endfor %}</dl></details>
                      {% else %}{{ 'Not assessed separately'|t }}{% endif %}
                    </td>
                    <td>{{ option.selection_probability is not null ? (option.selection_probability * 100)|number_format(0) ~ '%' : '—' }}</td>
                    <td>{% if option.brief_relevance %}<strong>{{ labels[option.brief_relevance.choice] }}</strong><br>{{ (option.brief_relevance.probabilities.relevant * 100)|number_format(0) }}% {{ 'relevant'|t }}{% if option.brief_relevance.needs_review %}<p class="sa-note">{{ 'Review this judgment'|t }}</p>{% endif %}{% else %}{{ 'Not applicable'|t }}{% endif %}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </details>
        {% if area.url %}<a href="{{ area.url }}" target="_blank" rel="noopener noreferrer">{{ 'Inspect the proposed project'|t }} →</a>{% endif %}
        {% if area.bundle_id %}<a href="{{ path('entity.node_type.edit_form', {'node_type': area.bundle_id}) }}">{{ 'Inspect the existing content type'|t }} →</a>{% endif %}
      </li>
    {% endfor %}
  </ol>
  <div class="sa-next"><h4>02 · {{ 'Validate the combination'|t }}</h4><p>{{ assessment.plan.validation }}</p><h4>03 · {{ 'Prepare the build tasks'|t }}</h4><p>{{ assessment.plan.handoff }}</p></div>
  <details class="sa-details"><summary>{{ 'Assessment details and alternative candidates'|t }}</summary>
  <p>{{ assessment.summary }}</p>
  <div class="sa-grid">
    <article class="sa-card sa-recommendation"><span class="sa-eyebrow">01 · {{ 'Reuse this site'|t }}</span><h4>{{ 'Start with existing configuration'|t }}</h4><p>{{ assessment.reuse_candidates|length }} {{ 'content types to reuse'|t }} · {{ assessment.workflow_candidates|length }} {{ 'workflow starting points'|t }}</p><p>{{ 'Inspect the actual fields, states and transitions below.'|t }}</p></article>
    <article class="sa-card sa-recommendation"><span class="sa-eyebrow">02 · {{ 'Consider existing solutions'|t }}</span><h4>{{ assessment.adoption_candidates|length }} {{ 'relevant catalog candidates'|t }}</h4><p>{{ 'Compare recipes and modules discovered from configured sources. Relevance does not establish installation compatibility.'|t }}</p></article>
    <article class="sa-card"><span class="sa-eyebrow">03 · {{ 'Build the remaining gap'|t }}</span><h4>{{ 'Keep custom work informed'|t }}</h4><p>{{ assessment.build_guidance }}</p></article>
  </div>

  {% if assessment.site.workflows %}
    <h4>{{ 'Moderation workflows already on this site'|t }}</h4>
    <div class="sa-grid">
      {% for id, workflow in assessment.site.workflows %}
        {% set answer = assessment.answers['workflow__' ~ id] %}
        <article class="sa-card sa-fit sa-fit--{{ answer.choice }}"><span class="sa-badge">{{ answer.needs_review ? 'Review needed'|t : labels[answer.choice] }}</span><h4>{{ workflow.label }}</h4><div class="sa-chips">{% for state in workflow.states %}<span>{{ state.label }}</span>{% endfor %}</div><p>{{ answer.criterion }}</p><details><summary>{{ 'Configured transitions and content types'|t }}</summary>{% for transition in workflow.transitions %}<p>{{ transition.label }}: {{ transition.from|join(', ') }} → {{ transition.to }}</p>{% endfor %}<p>{{ 'Applies to'|t }}: {{ workflow.node_bundles|join(', ') ?: 'No node content types'|t }}</p><p class="sa-note">{{ workflow.scope }}</p></details><a href="{{ path('entity.workflow.edit_form', {'workflow': id}) }}">{{ 'Inspect workflow'|t }} →</a></article>
      {% endfor %}
    </div>
  {% endif %}

  <h4>{{ 'Discovered recipes and modules'|t }}</h4>
  <p class="sa-note">{% if assessment.discovery.searched_ecosystem %}{{ 'Search'|t }}: “{{ assessment.discovery.query }}”{% else %}{{ 'Local manifests matched against your brief'|t }}{% endif %} · {{ assessment.discovery.returned }} {{ 'candidates assessed'|t }}{% if assessment.discovery.truncated %} · {{ 'Results limited: refine the brief to explore other candidates'|t }}{% endif %}</p>
  {% for warning in assessment.discovery.warnings %}<p class="sa-note">{{ warning }}</p>{% endfor %}
  <div class="sa-grid sa-grid--two">
    {% for id, candidate in assessment.candidates %}
      {% set answer = assessment.answers['recipe__' ~ id] %}
      <article class="sa-card sa-fit sa-fit--{{ answer.choice }}">
        <span class="sa-badge">{{ answer.needs_review ? 'Review needed'|t : labels[answer.choice] }}</span>
        <h4>{{ candidate.label }}</h4>
        <p class="sa-note">{{ candidate.kind }} · {{ availability[candidate.availability] }}</p>
        <code>{{ candidate.package }}</code>
        <p>{{ candidate.description|length > 320 ? candidate.description|slice(0, 320) ~ '…' : candidate.description }}</p>
        <details><summary>{{ 'Evidence and adoption checks'|t }}</summary>
          {% if candidate.description|length > 320 %}<p>{{ candidate.description }}</p>{% endif %}
          <p>{{ answer.criterion }}</p>
          <p>{{ 'Source'|t }}: <code>{{ candidate.source }}</code></p><p>{{ candidate.scope }}</p>
          {% if candidate.installs %}<p>{{ 'Declares extensions'|t }}: {{ candidate.installs|join(', ') }}</p>{% endif %}
          {% if candidate.includes_recipes %}<p>{{ 'Includes recipes'|t }}: {{ candidate.includes_recipes|join(', ') }}</p>{% endif %}
          {% if candidate.kind == 'recipe' %}<p>{{ 'Recipe application history is unknown.'|t }}</p>{% endif %}
          <p>{{ 'Verify dependencies, configuration overlap and permissions before adopting.'|t }}</p>
          {% if candidate.url %}<a href="{{ candidate.url }}" target="_blank" rel="noopener noreferrer">{{ 'Inspect upstream project'|t }} →</a>{% endif %}
        </details>
      </article>
    {% else %}<p>{{ 'No candidates were returned in the inspected scope. This does not establish that custom development is needed.'|t }}</p>{% endfor %}
  </div>
  <details class="sa-details"><summary>{{ 'Which sources were searched?'|t }}</summary><p>{{ assessment.discovery.scope }}</p>{% for source in assessment.discovery.sources %}<p><strong>{{ source.label }}</strong>{% if source.query %} · “{{ source.query }}”{% endif %} · {{ source.matches }} {{ 'reported matches'|t }}{% if source.truncated %} · {{ 'first page only'|t }}{% endif %}</p>{% endfor %}</details>

  <details class="sa-details"><summary>{{ 'Content modeling and presentation'|t }}</summary>
    <div class="sa-grid sa-grid--two">
      {% for id, heading in {'content_model': 'Content model'|t, 'presentation': 'Presentation'|t} %}{% set answer = assessment.answers[id] %}<article class="sa-card"><span class="sa-eyebrow">{{ heading }}</span><h4>{{ titles[answer.choice] ?? answer.choice }}</h4><p>{{ answer.criterion }}</p>{% if answer.needs_review %}<span class="sa-badge sa-review">{{ 'Review this judgment'|t }}</span>{% endif %}</article>{% endfor %}
    </div>
    <div class="sa-grid">
      {% for id, bundle in assessment.site.bundles %}{% set answer = assessment.answers['bundle__' ~ id] %}<article class="sa-card sa-fit sa-fit--{{ answer.choice }}"><span class="sa-badge">{{ answer.needs_review ? 'Review needed'|t : labels[answer.choice] }}</span><h4>{{ bundle.label }}</h4><div class="sa-chips">{% for field in bundle.fields %}<span>{{ field.label }}</span>{% endfor %}</div><p>{{ answer.criterion }}</p><a href="{{ path('entity.node_type.edit_form', {'node_type': id}) }}">{{ 'Inspect content type'|t }} →</a></article>{% endfor %}
    </div>
  </details>
  <div class="sa-next"><strong>{{ 'Next step'|t }}</strong><p>{{ assessment.follow_up }}</p></div>
  <details class="sa-details"><summary>{{ 'See exactly what informed this advice'|t }}</summary>
    <p>{{ 'Profile'|t }}: <code>{{ assessment.profile }}</code> · {{ 'Site snapshot'|t }}: <code>{{ assessment.site.fingerprint }}</code></p>
    <p>{{ 'Provider-reported usage'|t }}: {{ assessment.usage.input ?? '—' }} {{ 'input tokens'|t }} · {{ assessment.usage.output ?? '—' }} {{ 'output tokens'|t }}. {{ 'Provider caching may reuse a previous response and its usage figures. These are not a measurement of this call’s billed cost.'|t }}</p>
    <details><summary>{{ 'Search decision and selected term'|t }}</summary><pre>{{ assessment.search_plan|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>
    <details><summary>{{ 'Usage by stage'|t }}</summary><pre>{{ assessment.usage_by_stage|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>
    <details><summary>{{ 'Requests and usage within each stage'|t }}</summary><pre>{{ assessment.requests_by_stage|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>
    <p>{{ 'The module defines the questions and possible answers. Jev supplies judgments; displayed criteria are not generated explanations.'|t }}</p>
    {% for id, question in assessment.questions %}<details><summary>{{ id }} → {{ assessment.answers[id].choice }}</summary><p>{{ question.instructions }}</p><pre>{{ question.criteria|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre><pre>{{ assessment.answers[id]|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endfor %}
    <details><summary>{{ 'Exact site evidence'|t }}</summary><pre>{{ assessment.site|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>
    <details><summary>{{ 'Exact candidate evidence'|t }}</summary><pre>{{ assessment.candidates|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>
    {% for limitation in assessment.limitations %}<p class="sa-note">{{ limitation }}</p>{% endfor %}
  </details>
  </details>
</section>
