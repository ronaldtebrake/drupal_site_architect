{% set highlight = area.highlights %}
<div class="sa-choice sa-choice--{{ highlight.state }}"{% if highlight.primary %} data-option-id="{{ highlight.primary.id }}"{% endif %}>
  <span class="sa-eyebrow">{% if highlight.state == 'recommended' %}{{ 'Recommended starting point'|t }}{% elseif highlight.state == 'provisional' %}{{ 'Provisional recommendation'|t }}{% elseif highlight.state == 'conflicting' %}{{ 'Recommendation needs clarification'|t }}{% else %}{{ 'No recommendation yet'|t }}{% endif %}</span>
  {% if highlight.primary %}
    <h5>{{ highlight.primary.label }}</h5>
    <p class="sa-choice-scores">{{ 'Jev’s starting-point score'|t }}: {{ (area.selection.probability * 100)|number_format(0) }}% · {{ 'confidence'|t }} {{ (area.selection.confidence * 100)|number_format(0) }}%</p>
    {% if highlight.state == 'conflicting' %}<p>{{ 'Jev selected this starting point, but its separate contribution judgment does not support that choice. Review the conflicting evidence before choosing.'|t }}</p>{% endif %}
  {% endif %}
  <p class="sa-handoff-intro">{% if highlight.primary %}{{ area.handoff.intro }}{% else %}{{ 'No overall starting point is sufficiently supported yet. Compare the strongest building blocks below and resolve the remaining requirements before choosing a combination.'|t }}{% endif %}</p>
</div>
{% if area.requirements.parts %}
  <div class="sa-implementation-parts">
    <h5>{{ 'Build this from the following parts'|t }}</h5>
    <p>{{ 'Each item comes from your brief. Several parts can use the same component; different parts can need different components. These matches are investigation paths, not a verified integration.'|t }}</p>
    <ul>
      {% for part in area.requirements.parts %}
        {% if part.status != 'context' %}
          <li data-requirement-part="{{ part.id }}" data-status="{{ part.status }}">
            <p><strong>{{ part.text }}</strong></p>
            <p>{% if part.status in ['supported', 'partial'] %}<strong>{{ part.option_label }}</strong> · {{ part.status == 'supported' ? 'Candidate for this part'|t : 'Partial building block'|t }}{% elseif part.status == 'check' %}{{ 'Keep this as a condition to verify across the selected components.'|t }}{% else %}{{ 'Open requirement: no sufficiently supported match yet.'|t }}{% if part.option_label %} {{ 'Inspect @option as a possibility.'|t({'@option': part.option_label}) }}{% endif %}{% endif %}</p>
            {% if part.status == 'partial' %}<p>{{ 'The evidence supports only part of this item. Identify the missing configuration, behavior or additional component before building.'|t }}</p>{% endif %}
            {% if part.kind == 'record' and part.status in ['open', 'partial'] %}<p>{{ 'Compare existing record types and their fields for this item. If none fits, design a new type or entity and its required fields and relationships.'|t }}</p>{% endif %}
            {% if part.needs_review and part.status != 'open' %}<p class="sa-note">{{ 'Review needed; this has not been established as complete coverage.'|t }}</p>{% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    <details><summary>{{ 'Assembly checks and source judgments'|t }}</summary>
      <p>{{ area.requirements.integration_check }}</p>
      <p>{{ area.requirements.scope }}</p>
      {% for part in area.requirements.parts %}<p>{{ part.text }} · {{ part.kind }} · {{ part.status }}{% if part.coverage %} · {{ 'Evidence match'|t }} {{ (part.coverage.probabilities[part.coverage.choice] * 100)|number_format(0) }}% · {{ 'confidence'|t }} {{ (part.coverage.confidence * 100)|number_format(0) }}%{% endif %}</p>{% endfor %}
    </details>
  </div>
{% endif %}
<ol class="sa-builder-steps">
  {% set destination = area.handoff.configuration_area %}
  {% if destination %}
    <li>
      <h5>{{ 'Inspect @area on this site'|t({'@area': destination.label}) }}</h5>
      <p>{{ 'Check what is already configured before adding or replacing it.'|t }}{% if area.handoff.configuration_needs_review %} {{ 'Confirm that this is the right settings area for your requirement.'|t }}{% endif %}</p>
      <div class="sa-action-links">{% for link in destination.links %}<a href="{{ link.url }}">{{ link.label }} →</a>{% endfor %}</div>
      {% if destination.entity_type %}
        {% if destination.records %}
          <details class="sa-current-config"><summary>{{ 'Existing configuration and fields'|t }} · {{ destination.records|length }}</summary>
            {% for record in destination.records %}
              <div class="sa-current-record"><strong>{{ record.label }}</strong>
                {% if record.fields %}<ul>{% for name, field in record.fields %}<li>{{ field.label }} · {{ field.type }}{% if field.required %} · {{ 'required'|t }}{% endif %}{% if field.target_type %} · {{ 'references'|t }} {{ field.target_type }}{% if field.target_bundles %} ({{ field.target_bundles|join(', ') }}){% endif %}{% endif %}</li>{% endfor %}</ul>{% else %}<p>{{ 'No configurable fields were found on this bundle. Base fields may still be provided by its entity type.'|t }}</p>{% endif %}
                <div class="sa-action-links">{% for link in record.links %}<a href="{{ link.url }}">{{ link.label }} →</a>{% endfor %}</div>
              </div>
            {% endfor %}
          </details>
        {% else %}<p>{{ 'No bundles were found in the inspected scope. A definition will need to be created or supplied by a suitable recipe if you choose this model.'|t }}</p>{% endif %}
      {% endif %}
    </li>
  {% endif %}
  {% if highlight.resources %}
    <li>
      <h5>{{ 'Options to focus on'|t }}</h5>
      <p>{{ 'Up to three options are highlighted. A starting point leads only when both its selection and contribution are sufficiently supported. Checked matches for specific parts come next, then other options ordered by contribution evidence. Foundations and supporting options may serve different requirements.'|t }}</p>
      {% for resource in highlight.resources %}
        <details class="sa-resource{{ resource.selected ? ' sa-resource--selected' : '' }}" data-option-id="{{ resource.option_id }}"{{ resource.selected ? ' open' : '' }}>
          <summary>{{ resource.label }} <span class="sa-note">· {{ resource.kind }}</span> <span class="sa-resource-role">{% if resource.selected %}{{ highlight.state == 'recommended' ? 'Recommended starting point'|t : 'Provisional recommendation'|t }}{% elseif resource.role == 'foundation' %}{{ highlight.primary ? 'Alternative foundation'|t : 'Possible foundation'|t }}{% else %}{{ 'Supporting option'|t }}{% endif %}{% if resource.needs_review and not resource.selected %} · {{ 'Uncertain fit'|t }}{% endif %}</span></summary>
          <p class="sa-note">{{ 'Contribution score'|t }}: {{ (resource.role_probability * 100)|number_format(0) }}% {{ resource.role == 'foundation' ? 'as a foundation'|t : 'as a supporting option'|t }} · {{ 'confidence'|t }} {{ (resource.role_confidence * 100)|number_format(0) }}%</p>
          {% if resource.parts %}<p>{{ 'Consider for these parts of your brief'|t }}:</p><ul>{% for part in resource.parts %}<li>{{ part.text }}{% if part.status == 'partial' %} · {{ 'Partial match; gaps remain'|t }}{% endif %}</li>{% endfor %}</ul>{% endif %}
          <p>{{ resource.instruction }}</p>
          {% if resource.module_name %}<p class="sa-note">{{ 'Module'|t }}: <code>{{ resource.module_name }}</code> · {{ resource.availability == 'enabled_module' ? 'Already enabled'|t : 'Code available; not enabled'|t }}</p>{% endif %}
          {% if resource.links %}<div class="sa-action-links">{% for link in resource.links %}<a href="{{ link.url }}">{{ link.label }} →</a>{% endfor %}</div>{% endif %}
          <p class="sa-note">{{ 'Supplied by'|t }} <code>{{ resource.package }}</code>{% if resource.configuration %} · {{ 'Configuration inspected locally'|t }}{% endif %}</p>
          {% if resource.description %}<p>{{ resource.description|length > 360 ? resource.description|slice(0, 360) ~ '…' : resource.description }}</p>{% endif %}
          {% if resource.configuration %}
            <p>{{ 'Of the explicitly listed configuration items, @existing already exist and @missing were not found on this site.'|t({'@existing': resource.configuration_counts.existing, '@missing': resource.configuration_counts.missing}) }}{% if resource.configuration_counts.unresolved %} {{ '@count targets need further inspection.'|t({'@count': resource.configuration_counts.unresolved}) }}{% endif %}</p>
            {% for model in resource.existing_models %}
              <div class="sa-current-record"><strong>{{ 'Already configured: @model'|t({'@model': model.label}) }}</strong>
                {% if model.fields %}<p>{{ 'Current fields'|t }}: {% for field in model.fields %}{{ field.label }} ({{ field.type }}){{ not loop.last ? ', ' }}{% endfor %}.</p>{% endif %}
                <div class="sa-action-links">{% for link in model.links %}<a href="{{ link.url }}">{{ link.label }} →</a>{% endfor %}</div>
              </div>
            {% endfor %}
            <details class="sa-config-changes"><summary>{{ 'Configuration to review'|t }} · {{ resource.configuration|length }}</summary>
              <ul>{% for config in resource.configuration %}
                <li><strong>{{ config.label }}</strong>{% if config.type_label %} · {{ config.type_label }}{% endif %}{% if config.field_type %} · {{ config.field_type }} {{ 'field'|t }}{% if config.bundle %} ({{ config.entity_type }} / {{ config.bundle }}){% endif %}{% endif %}
                  <p>{{ config.instruction }}</p><code>{{ config.name }}</code>
                  <div class="sa-action-links">{% for link in config.links %}<a href="{{ link.url }}">{{ link.label }} →</a>{% endfor %}</div>
                </li>
              {% endfor %}</ul>
              <p class="sa-note">{{ 'Existing names do not establish identical settings. Review included recipes, imports and configuration actions before applying anything.'|t }}</p>
            </details>
          {% endif %}
          {% if resource.installs %}<p>{{ 'Modules requested by the recipe'|t }}: {{ resource.installs|join(', ') }}</p>{% endif %}
          {% if resource.includes_recipes %}<p>{{ 'Included recipes to inspect'|t }}: {{ resource.includes_recipes|join(', ') }}</p>{% endif %}
          {% if resource.url %}<a href="{{ resource.url }}" target="_blank" rel="noopener noreferrer">{{ 'Read the project details'|t }} →</a>{% endif %}
          {% if resource.source %}<details><summary>{{ 'Evidence source'|t }}</summary><code>{{ resource.source }}</code></details>{% endif %}
        </details>
      {% endfor %}
      {% if highlight.more_resources %}<p class="sa-note">{{ '@count more resources are included below in “Options, scores and remaining gaps”.'|t({'@count': highlight.more_resources}) }}</p>{% endif %}
    </li>
  {% endif %}
  <li>
    <h5>{{ 'Decide the remaining changes'|t }}</h5>
    <p>{{ area.check }}{% if area.check_needs_review %} {{ 'Confirm this priority with the site builder.'|t }}{% endif %}</p>
    <details class="sa-requirement"><summary>{{ 'Check against your requirement'|t }}</summary><p>{{ area.source_text }}</p></details>
  </li>
</ol>
