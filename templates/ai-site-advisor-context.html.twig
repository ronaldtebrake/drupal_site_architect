<section class="sa-evidence">
  <div class="sa-section-title"><div><span class="sa-eyebrow">{{ 'Collected from this Drupal site'|t }}</span><h3>{{ 'What the advisor can see'|t }}</h3></div><span class="sa-badge">{{ snapshot.bundles|length }} {{ 'content types'|t }}</span></div>
  <p class="sa-note">{{ snapshot.scope }} · Drupal {{ snapshot.drupal_version }} · {{ 'No content values or credentials'|t }}</p>
  <div class="sa-grid">
    {% for bundle in snapshot.bundles %}
      <article class="sa-card"><span class="sa-eyebrow">{{ 'Existing content type'|t }}</span><h4>{{ bundle.label }}</h4><code>{{ bundle.id }}</code><p>{{ bundle.description }}</p><div class="sa-chips">{% for name, field in bundle.fields %}<span title="{{ name }} · {{ field.type }}">{{ field.label }}</span>{% endfor %}</div></article>
    {% else %}<p>{{ 'No node content types were found in the selected scope.'|t }}</p>{% endfor %}
  </div>
  <details class="sa-details"><summary>{{ 'Available capabilities and recipe catalog'|t }}</summary>
    <div class="sa-chips">{% for module, enabled in snapshot.enabled_features %}<span class="{{ enabled ? 'sa-enabled' : '' }}">{{ module }} · {{ enabled ? 'enabled'|t : 'not enabled'|t }}</span>{% endfor %}</div>
    <p>{{ 'Active moderation workflows'|t }}: {{ snapshot.workflows|length }}. {{ 'Their states, transitions and content-type assignments are read directly from configuration.'|t }}</p>
    <p>{{ 'Registered configuration areas'|t }}: {{ snapshot.configuration_areas|length }}. {{ 'Bundle fields and available administration links are discovered from Drupal entity definitions. Other configuration areas provide destinations only; their arbitrary settings are not collected.'|t }}</p>
    {% for workflow in snapshot.workflows %}<p><strong>{{ workflow.label }}</strong>: {% for state in workflow.states %}{{ state.label }}{{ not loop.last ? ', ' }}{% endfor %}</p>{% endfor %}
    <details><summary>{{ 'Discovered local recipe manifests'|t }} ({{ recipes|length }})</summary>
      <p>{{ 'These manifests were found in core, Composer recipe packages and configured directories. Presence does not establish application history. The adviser decides from your brief whether searching configured ecosystem sources would help.'|t }}</p>
      {% for recipe in recipes %}
        {% if recipe.invalid_manifest %}<p>{{ 'Could not read manifest'|t }}: {{ recipe.invalid_manifest }}</p>
        {% else %}<p><strong>{{ recipe.label }}</strong> — {{ recipe.description }} <code>{{ recipe.source }}</code></p>{% endif %}
      {% endfor %}
    </details>
    <p><strong>{{ 'Site policy'|t }}:</strong> {{ snapshot.site_policy }}</p>
  </details>
</section>
